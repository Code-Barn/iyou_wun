# iYou WUN Environment Configuration
# Copy this to .env and fill in credentials

# Django Core (WUN_ namespace)
WUN_SECRET_KEY=your-secret-key-here
WUN_DEBUG=True
WUN_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (default: SQLite; use postgres:// for production)
DATABASE_URL=sqlite:///db.sqlite3

# OIDC Client configuration for WUN (public PKCE client, no secret needed)
OIDC_RP_CLIENT_ID=iyou-wun-satellite-client
OIDC_RP_CLIENT_SECRET=

# OIDC Provider endpoints (IdP) — local development overrides
# Production defaults use cluster-internal DNS; these override for dev
OIDC_OP_AUTHORIZATION_ENDPOINT=http://127.0.0.1:8000/openid/authorize/
OIDC_OP_TOKEN_ENDPOINT=http://127.0.0.1:8000/openid/token/
OIDC_OP_USER_ENDPOINT=http://127.0.0.1:8000/openid/userinfo/
OIDC_OP_JWKS_ENDPOINT=http://127.0.0.1:8000/openid/jwks/

# OIDC callback URL — must match IdP client registration
OIDC_RP_CALLBACK_URL=http://127.0.0.1:8001/oidc/callback/

# Credential Issuance — Node identity
# NODE_DID is the node's own DID (used as the VC issuer).
# NODE_PRIVATE_KEY_HEX is the hex-encoded Ed25519 private key (32 or 64 hex chars).
#   If omitted, the key is derived from WUN_SECRET_KEY (dev-only fallback).
# NODE_DID=did:key:z6Mk...
# NODE_PRIVATE_KEY_HEX=...
